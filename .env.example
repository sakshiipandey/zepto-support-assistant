# Kie.ai Configuration (Primary Provider)
# Set your Kie.ai API key from https://kie.ai
KIE_API_KEY=your_kie_ai_api_key_here
# Alternatively, OPENAI_API_KEY can also be used:
OPENAI_API_KEY=your_kie_ai_api_key_here

# Kie.ai Endpoint and Model
OPENAI_BASE_URL=https://api.kie.ai/gpt-5-2/v1
LLM_MODEL=gpt-5-2

# Path to knowledge documents (defaults to docs)
DOCS_PATH=docs

# Optional: set to true to test RAG retrieval & UI locally without consuming API credits
MOCK_LLM=false